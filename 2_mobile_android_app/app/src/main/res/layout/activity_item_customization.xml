<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnCloseCustomization"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#EEEEEE"
                android:gravity="center"
                android:text="✕"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvCustomItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Item Customization"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCustomItemPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="$0.00"
                    android:textColor="#FF6A13"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Size"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSizeS"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#FF6A13"
                android:text="S"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnSizeM"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#EEEEEE"
                android:text="M"
                android:textColor="#444444" />
            <Button
                android:id="@+id/btnSizeL"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#EEEEEE"
                android:text="L"
                android:textColor="#444444" />
            <Button
                android:id="@+id/btnSizeXL"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#EEEEEE"
                android:text="XL"
                android:textColor="#444444" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Temperature"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnTempIced"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#FF6A13"
                android:text="Iced"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnTempHot"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="#EEEEEE"
                android:text="Hot"
                android:textColor="#444444" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sugar Level"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSugarYes"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#FF6A13"
                android:text="Sugar"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnSugarNo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="#EEEEEE"
                android:text="No Sugar"
                android:textColor="#444444" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Toppings"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />
        <CheckBox
            android:id="@+id/cbTopping1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Placeholder Toppings 1"
            android:textColor="#444444" />
        <CheckBox
            android:id="@+id/cbTopping2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Placeholder Toppings 2"
            android:textColor="#444444" />
        <CheckBox
            android:id="@+id/cbTopping3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Placeholder Toppings 3"
            android:textColor="#444444" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Note"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etKitchenNote"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Add a note..."
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btnDoneCustomization"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#FF6A13"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>