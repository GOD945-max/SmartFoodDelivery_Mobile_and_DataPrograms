<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert" />
        <EditText
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Search dishes, calories, restaurants..."
            android:paddingHorizontal="16dp"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Search Filters"
        android:textColor="#222222"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Calorie Range"
        android:textColor="#666666"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnCalorieUnder400"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FF6A13"
            android:text="Under 400 kcal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnCalorie400to600"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEEEEE"
            android:text="400 - 600 kcal"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Sort By"
        android:textColor="#666666"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnSortPopular"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FF6A13"
            android:text="Most Popular"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnSortNearest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEEEEE"
            android:text="Nearest"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnSortTopRated"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEEEEE"
            android:text="Top Rated"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Diet"
        android:textColor="#666666"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnDietVegan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FF6A13"
            android:text="Vegan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnDietKeto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEEEEE"
            android:text="Keto"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnDietLowCarb"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEEEEE"
            android:text="Low Carb"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Perks"
        android:textColor="#666666"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnPerkFreeShipping"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#EEEEEE"
            android:text="Free Shipping"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnPerkDiscount"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEEEEE"
            android:text="Discounts"
            android:textAllCaps="false"
            android:textColor="#444444"
            android:textSize="12sp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <Button
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#FF6A13"
        android:text="Apply Filters"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>