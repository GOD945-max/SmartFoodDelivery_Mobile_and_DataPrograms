<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnBackHub"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#EEEEEE"
            android:gravity="center"
            android:text="←"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flagship Hub"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official partner stores and exclusive menus"
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/bannerRestaurant1"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="14dp"
                android:background="#FFD500"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="FLAGSHIP STORE"
                    android:textColor="#FFD500"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Placeholder Restaurant 1"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Placeholder Descriptions"
                    android:textColor="#333333"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/bannerRestaurant2"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="14dp"
                android:background="#007AFF"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="FLAGSHIP STORE"
                    android:textColor="#007AFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Placeholder Restaurant 2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Placeholder Descriptions"
                    android:textColor="#E0F0FF"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/bannerRestaurant3"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="14dp"
                android:background="#FF6A13"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="FLAGSHIP STORE"
                    android:textColor="#FF6A13"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Placeholder Restaurant 3"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Placeholder Descriptions"
                    android:textColor="#FFE5D4"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/bannerRestaurant4"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="14dp"
                android:background="#34C759"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="FLAGSHIP STORE"
                    android:textColor="#34C759"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Placeholder Restaurant 4"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Placeholder Descriptions"
                    android:textColor="#E8F8EC"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>