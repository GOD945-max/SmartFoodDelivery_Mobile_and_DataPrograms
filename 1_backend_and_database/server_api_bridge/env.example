# Sao chép file này thành .env (KHÔNG commit .env lên Git)
PORT=3000

# PostgreSQL (db.js của TV1 đọc các biến này)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_food_db
# DEBUG_SQL=true

# JWT: tối thiểu 32 ký tự và phải GIỐNG HỆT giữa các thành viên (server gọi jwtSecret() và báo lỗi ngay khi khởi động nếu thiếu)
JWT_SECRET=smartfood_dev_secret_change_me_0123456789abcdef
